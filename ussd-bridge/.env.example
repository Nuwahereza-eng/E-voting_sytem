# Bridge configuration
PORT=4000

# Soroban / Stellar
CONTRACT_ID=
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# Registry file: JSON map of msisdn -> { publicKey, secret, memberIndex }
# The 'secret' is a custodial S... key held by the bridge. This is a
# hackathon simplification — see AGENT_BUILD_BRIEF.md §6.
REGISTRY_PATH=./data/registry.json

# Members file: JSON array of Stellar public keys, in the exact order
# used when the community's Merkle root was computed. Used to build
# proofs for USSD/SMS voters.
MEMBERS_PATH=./data/members.json

# When set, the bridge will attempt to send a confirmation SMS back
# to the voter via Africa's Talking. Leave empty to disable.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Sunbird AI — Ugandan-language translate + STT (used by multilingual
# ballot rendering and the voice IVR channel). Set SUNBIRD_API_KEY to
# the long-lived key from the Sunbird dashboard (copied directly into
# the Authorization header as `Bearer <key>`). Alternatively supply a
# username/password for on-the-fly OAuth. Leave everything empty to
# run in dev-stub mode (translate() echoes with a [lang] prefix,
# transcribe() returns "one" as the fake candidate name).
SUNBIRD_BASE_URL=https://api.sunbird.ai
SUNBIRD_API_KEY=
# Legacy alias for SUNBIRD_API_KEY. Set one or the other, not both.
SUNBIRD_TOKEN=
SUNBIRD_USERNAME=
SUNBIRD_PASSWORD=

# File path for cached ballot translations (per election, per language).
TRANSLATIONS_PATH=./data/translations.json
# File path for the per-vote audit log used by anomaly detection.
VOTE_LOG_PATH=./data/votes-log.json
